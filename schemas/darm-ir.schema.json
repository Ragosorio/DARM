          "type": "string"
        }
      },
      "required": [
        "label"
      ]
    },
    "Resource": {
      "description": "A media file, caption track or font used by the book.",
      "type": "object",
      "properties": {
        "alt": {
          "description": "Text alternative. Required by the compiler for images and video.",
          "type": [
            "string",
            "null"
          ]
        },
        "captions": {
          "description": "Caption/subtitle tracks (video and audio).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptionTrack"
          }
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "media_type": {
          "description": "IANA media type, verified against the file content by the compiler.",
          "type": "string"
        },
        "name": {
          "description": "Name used by blocks to refer to this resource. Unique.",
          "type": "string"
