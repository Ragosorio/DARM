        "poster": {
          "description": "Name of an image resource shown before a video plays.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "description": "Lower-case hex SHA-256 of the file (empty for remote resources).",
          "type": "string",
          "default": ""
        },
        "size": {
          "description": "Size in bytes (0 for remote resources).",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/ResourceSource"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "description": "Full-text transcript (audio and video).",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "kind",
        "source",
        "media_type"
      ]
    },
