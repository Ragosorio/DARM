            },
            {
              "type": "null"
            }
          ]
        },
        "drop_caps": {
          "type": "boolean"
        },
        "heading_font": {
          "$ref": "#/$defs/FontRef"
        },
        "hyphenate": {
          "type": "boolean"
        },
        "ink": {
          "description": "Text colour, `#rrggbb`.",
          "type": "string"
        },
        "justify": {
          "type": "boolean"
        },
        "paper": {
          "description": "Paper colour, `#rrggbb`.",
          "type": "string"
        },
        "paragraph": {
          "$ref": "#/$defs/ParagraphStyle"
        }
      },
      "required": [
        "paper",
        "ink",
        "accent",
        "body_font",
        "heading_font",
        "paragraph",
        "justify",
        "hyphenate",
        "drop_caps"
      ]
    },
    "TocEntry": {
      "type": "object",
      "properties": {
        "level": {
          "description": "1 = chapter, 2 = section.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "target": {
          "description": "Anchor name to jump to.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "when": {
          "description": "Entry is listed only while this holds (mirrors the chapter/section condition).",
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "target",
        "level"
      ]
    },
    "Transition": {
      "description": "How the reader moves to a non-adjacent location.",
      "oneOf": [
        {
          "description": "Riffle through the leaves in between (default).",
          "type": "string",
          "const": "flip"
        },
        {
          "description": "Cross-fade.",
          "type": "string",
          "const": "fade"
        },
        {
          "description": "Cut.",
          "type": "string",
          "const": "none"
        }
      ]
    }
  }
}
