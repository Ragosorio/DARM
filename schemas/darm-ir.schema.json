        {
          "description": "Integer clamped to `min..=max` on every assignment.",
          "type": "object",
          "properties": {
            "initial": {
              "type": "integer",
              "format": "int64"
            },
            "max": {
              "type": "integer",
              "format": "int64"
            },
            "min": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string",
              "const": "int"
            }
          },
          "required": [
            "type",
            "initial",
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "properties": {
            "initial": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "bool"
            }
          },
          "required": [
            "type",
            "initial"
          ]
        },
        {
          "description": "One of a closed set of strings.",
          "type": "object",
          "properties": {
            "initial": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "initial",
            "values"
          ]
        }
      ],
      "required": [
        "name"
      ]
    },
    "TextStyle": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "body",
            "small",
            "caption",
            "mono"
          ]
        },
        {
          "description": "Larger opening paragraph.",
          "type": "string",
          "const": "lead"
        },
        {
          "description": "Body paragraph with a drop capital.",
          "type": "string",
          "const": "dropcap"
        },
        {
          "description": "Line breaks are preserved, no justification.",
          "type": "string",
          "const": "verse"
        },
        {
          "description": "Large display lettering (title plates, fixed pages).",
          "type": "string",
          "const": "display"
        }
      ]
    },
    "Theme": {
      "description": "Visual identity of the book interior.",
      "type": "object",
      "properties": {
        "accent": {
          "description": "Accent colour for ornaments, links and controls, `#rrggbb`.",
          "type": "string"
        },
        "body_font": {
          "$ref": "#/$defs/FontRef"
        },
        "dark": {
          "description": "Optional palette for the reader's dark mode. Derived by the reader when absent.",
