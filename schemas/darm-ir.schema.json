            "location": {
              "type": "string",
              "const": "packaged"
            }
          },
          "required": [
            "location",
            "entry"
          ]
        },
        {
          "description": "Loaded from the network, only if the host is in [`Meta::network`]\nand the reader's user allows it.",
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "const": "remote"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "location",
            "url"
          ]
        }
      ]
    },
