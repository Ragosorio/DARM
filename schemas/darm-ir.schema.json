        "ink": {
          "type": "string"
        },
        "paper": {
          "type": "string"
        }
      },
      "required": [
        "paper",
        "ink",
        "accent"
      ]
    },
    "ParagraphStyle": {
      "oneOf": [
        {
          "description": "First-line indent, no space between paragraphs (book style).",
          "type": "string",
          "const": "indent"
        },
        {
          "description": "No indent, space between paragraphs.",
          "type": "string",
          "const": "spaced"
        }
      ]
    },
    "QuizAnswer": {
      "type": "object",
