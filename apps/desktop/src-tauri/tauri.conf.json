{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DARM",
  "version": "0.1.0",
  "identifier": "org.darm.reader",
  "build": {
    "frontendDist": "../../reader/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../reader run dev",
    "beforeBuildCommand": "npm --prefix ../reader run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DARM",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: https:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: https:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Reader for DARM interactive books",
    "longDescription": "DARM opens .darm interactive books: paginated reading with page turns, search, notes and offline use. Books stay on this device.",
    "publisher": "The DARM contributors",
    "copyright": "Copyright (c) The DARM contributors. Apache-2.0.",
    "license": "Apache-2.0",
    "fileAssociations": [
      {
        "ext": ["darm"],
        "name": "DARM book",
        "description": "DARM book",
        "mimeType": "application/vnd.darm",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": {
          "identifier": "org.darm.book",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/org.darm.reader.xml": "linux/org.darm.reader.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/org.darm.reader.xml": "linux/org.darm.reader.xml"
        }
      }
    },
    "iOS": {
      "minimumSystemVersion": "16.4"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
